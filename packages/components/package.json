{
  "name": "vuepress-plugin-components",
  "version": "2.0.0-rc.109",
  "description": "Components collection plugin for VuePress2",
  "keywords": [
    "components",
    "vuepress",
    "vuepress-plugin",
    "vuepress2"
  ],
  "homepage": "https://plugin-components.vuejs.press/",
  "bugs": {
    "url": "https://github.com/vuepress-theme-hope/vuepress-theme-hope/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Mr.Hope",
    "email": "mister-hope@outlook.com",
    "url": "https://mister-hope.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuepress-theme-hope/vuepress-theme-hope.git",
    "directory": "packages/components"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/client/**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./components/*": {
      "types": "./dist/client/components/*.d.ts",
      "default": "./dist/client/components/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "clean": "rimraf ./dist",
    "dev": "pnpm build --watch"
  },
  "dependencies": {
    "@stackblitz/sdk": "^1.11.1",
    "@vuepress/helper": "catalog:vuepress",
    "@vuepress/plugin-sass-palette": "catalog:vuepress",
    "@vueuse/core": "catalog:range",
    "balloon-css": "catalog:range",
    "create-codepen": "^2.0.4",
    "qrcode": "^1.5.4",
    "vue": "catalog:range",
    "vuepress-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@vuepress/bundler-vite": "catalog:vuepress"
  },
  "peerDependencies": {
    "sass": "catalog:range",
    "sass-embedded": "catalog:range",
    "sass-loader": "catalog:range",
    "vuepress": "catalog:vuepress"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    },
    "sass-embedded": {
      "optional": true
    },
    "sass-loader": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=8",
    "pnpm": ">=7",
    "yarn": ">=2"
  }
}
