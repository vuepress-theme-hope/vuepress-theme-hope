{
  "name": "vuepress-theme-hope-root",
  "private": true,
  "description": "A VuePress theme with tons of features",
  "workspaces": [
    "demo/*",
    "docs/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm run --stream -r build",
    "bundle": "cross-env NODE_ENV=production pnpm run --stream -r build",
    "clean": "pnpm run --stream -r clean",
    "dev": "pnpm run --parallel -r dev",
    "docs:vite-build": "pnpm run -r docs:vite-build",
    "docs:webpack-build": "pnpm run -r docs:webpack-build",
    "lint": "pnpm lint:oxlint --fix && oxfmt . & pnpm lint:stylelint --fix",
    "lint:check": "pnpm lint:oxlint && oxfmt --check . && pnpm lint:stylelint",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "lint:oxlint": "oxlint --report-unused-disable-directives --deny-warnings",
    "lint:stylelint": "stylelint \"**/*.{css,scss}\" \"**/.vuepress/**/*.{css,scss}\"",
    "pkg:check-update": "pnpm dlx npm-check-updates",
    "pkg:update": "pnpm up -r",
    "prepare": "husky",
    "release": "pnpm clean && pnpm bundle && pnpm release:version && pnpm release:publish && pnpm release:sync",
    "release:publish": "lerna publish from-package --yes",
    "release:sync": "unrun scripts/syncNpmmirror.ts",
    "release:version": "lerna version",
    "test": "vitest --coverage"
  },
  "devDependencies": {
    "@lerna-lite/cli": "5.6.1",
    "@lerna-lite/publish": "5.6.1",
    "@mr-hope/tsconfig": "0.0.4",
    "@types/node": "22.20.1",
    "@types/webpack-env": "1.18.8",
    "@vitest/coverage-istanbul": "5.0.0",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "cross-env": "10.1.0",
    "husky": "9.1.7",
    "markdownlint-cli2": "0.23.2",
    "nano-staged": "1.0.2",
    "oxc-config-hope": "0.3.13",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "picocolors": "1.1.1",
    "publint": "0.3.24",
    "rimraf": "6.1.3",
    "serve": "14.2.6",
    "stylelint": "17.15.0",
    "stylelint-config-hope": "12.1.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.1",
    "tsdown": "0.23.0",
    "typescript": "catalog:",
    "unrun": "0.3.1",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vuepress": "catalog:vuepress"
  },
  "nano-staged": {
    "**/*": "oxfmt --no-error-on-unmatched-pattern",
    "*.vue": "oxlint --fix",
    "*.{cjs,mjs,js,ts}": [
      "oxlint --fix",
      "vitest related --run"
    ],
    "*.md": "markdownlint-cli2 --fix",
    "*.s?css": "stylelint --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.22.0 || ^24.18.0 || ^26.6.0",
      "onFail": "error"
    }
  }
}
